# Copy to web/.env (never commit .env). Server-side only; never prefix secrets with PUBLIC_ or VITE_.

# Run mode: mock (in-repo stateful app twins) or real (live connectors)
MODE=mock

# LLM (OpenAI-compatible). Local default is Ollama.
# Use 127.0.0.1 (not localhost) to avoid the Node IPv6 ::1 resolution issue on Windows.
# Hosted fallback example: LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b

# Ollama native API (used for think:false requests)
OLLAMA_URL=http://127.0.0.1:11434

# Notion tracker (integration token + data source shared with the integration)
NOTION_TOKEN=
# Data source id, not the database id; run `npx tsx scripts/notion-setup.ts` to resolve it.
# Share the database with the integration via ... > Connections.
NOTION_DATA_SOURCE_ID=

# Google (Gmail drafts, Calendar, Docs, Drive) OAuth for a single demo user
# OAuth client type Desktop app; add your account as a Test user; mint a refresh token with
# `npx tsx scripts/google-auth.ts` (Testing-mode tokens expire after 7 days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to write deadline events to
GOOGLE_CALENDAR_ID=primary
# Local loopback port for the one-time OAuth consent flow
GOOGLE_OAUTH_PORT=53682

# Read-only portfolio evidence
GITHUB_USERNAME=wolfwdavid
HF_USERNAME=WolfDavid
# Optional GitHub token: raises the limit from 60 to 5000 req/hr and enables per-repo language
# breakdown. Read-only; no scopes needed. Hugging Face public data needs no token.
GITHUB_TOKEN=
# Optional absolute path to a local Obsidian vault (read-only; tags and frontmatter only)
OBSIDIAN_VAULT_PATH=

# HMAC secret for signed plan approval tokens
PLAN_SIGNING_SECRET=
