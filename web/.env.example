# Copy to web/.env (never commit .env). Server-side only; never prefix secrets with PUBLIC_ or VITE_.

# Run mode: mock (in-repo stateful app twins) or real (live connectors)
MODE=mock

# LLM (OpenAI-compatible). Local default is Ollama.
# Use 127.0.0.1 (not localhost) to avoid the Node IPv6 ::1 resolution issue on Windows.
# Hosted fallback example: LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b

# Ollama native API (used for think:false requests)
OLLAMA_URL=http://127.0.0.1:11434

# Notion tracker (integration token + data source shared with the integration)
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Google (Gmail drafts, Calendar, Docs, Drive) OAuth for a single demo user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Read-only portfolio evidence
GITHUB_USERNAME=wolfwdavid
HF_USERNAME=WolfDavid

# HMAC secret for signed plan approval tokens
PLAN_SIGNING_SECRET=
